---
import { LOADING_TIPS } from '../lib/tips';
import type { Country } from '../lib/countries';

interface Props {
  from: Country;
  to: Country;
  slug: string;
}
const { from, to, slug } = Astro.props;

const earth =
  '<path d="M21.54 15H17a2 2 0 0 0-2 2v4.54"/><path d="M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17"/><path d="M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05"/><circle cx="12" cy="12" r="10"/>';
const plane =
  '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>';
---

<div class="lwrap">
  <div class="lcard">
    <p class="lroute">{from.name} <span class="larr">→</span> {to.name}</p>

    <div class="lorb" aria-hidden="true">
      <div class="lring"></div>
      <div class="lglobe">
        <svg viewBox="0 0 24 24" class="lglobe-ic" set:html={earth}></svg>
      </div>
      <div class="lspin">
        <div class="lplane"><svg viewBox="0 0 24 24" class="lplane-ic" set:html={plane}></svg></div>
      </div>
    </div>

    <h1 class="ltitle">Finding your visa requirements</h1>
    <p class="lstep" id="iov-step">Checking your passport country…</p>
    <p class="lpct" id="iov-pct">0%</p>

    <div class="ltip">
      <span class="ltip-label">✨ Travel tip</span>
      <p id="iov-tip">{LOADING_TIPS[0]}</p>
    </div>
  </div>
</div>

<script type="application/json" id="iov-tips" set:html={JSON.stringify(LOADING_TIPS)}></script>
<script define:vars={{ slug }}>
  const tips = JSON.parse(document.getElementById('iov-tips').textContent);
  const tipEl = document.getElementById('iov-tip');
  const stepEl = document.getElementById('iov-step');
  const pctEl = document.getElementById('iov-pct');

  const STEPS = [
    'Checking your passport country…',
    'Reading official government sources…',
    'Checking visa types & documents…',
    'Putting your guide together…',
  ];

  // Rotate travel tips
  let t = 0;
  const tipTimer = setInterval(() => {
    t = (t + 1) % tips.length;
    tipEl.style.opacity = '0';
    setTimeout(() => { tipEl.textContent = tips[t]; tipEl.style.opacity = '1'; }, 250);
  }, 3000);

  // Ease the % up toward 95 while we wait, and swap the step message with progress.
  let pct = 0;
  const pctTimer = setInterval(() => {
    pct += Math.max(0.4, (95 - pct) * 0.035);
    if (pct > 95) pct = 95;
    pctEl.textContent = Math.round(pct) + '%';
    const idx = Math.min(STEPS.length - 1, Math.floor(pct / 25));
    if (stepEl.textContent !== STEPS[idx]) stepEl.textContent = STEPS[idx];
  }, 200);

  const finish = () => { clearInterval(tipTimer); clearInterval(pctTimer); };

  // Kick off generation, then reload to show the cached result.
  fetch('/api/generate', {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ slug }),
  })
    .then((r) => r.json())
    .then((res) => {
      finish();
      if (res && res.ok) {
        pctEl.textContent = '100%';
        stepEl.textContent = 'Ready!';
        setTimeout(() => window.location.reload(), 300);
        return;
      }
      showNotReady();
    })
    .catch(() => { finish(); showNotReady(); });

  function showNotReady() {
    const card = document.querySelector('.lcard');
    if (!card) return;
    card.innerHTML =
      '<div class="lnot">🛫</div>' +
      '<h1 class="ltitle">This guide is on the way</h1>' +
      '<p class="lstep">We haven’t published this exact route yet — we add and verify new corridors regularly.</p>' +
      '<a href="/countries" class="lbtn">Browse routes we’ve verified →</a>';
  }
</script>

<style>
  .lwrap { position: fixed; inset: 0; z-index: 100; background: var(--cream); display: grid; place-items: center; padding: 1.5rem; }
  .lcard { width: 100%; max-width: 30rem; text-align: center; }
  .lroute { font-size: .85rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: color-mix(in oklab, var(--navy) 55%, transparent); }
  .larr { color: var(--primary); }

  /* Orbit scene */
  .lorb { position: relative; width: min(14rem, 62vw); aspect-ratio: 1; margin: 2rem auto 0; }
  .lring { position: absolute; inset: 0; border-radius: 999px; border: 1px dashed color-mix(in oklab, var(--primary) 32%, transparent); }
  .lglobe { position: absolute; inset: 1.5rem; border-radius: 999px; background: var(--navy); color: var(--primary-foreground); display: grid; place-items: center; box-shadow: var(--shadow-soft); animation: lfloat 3s ease-in-out infinite; }
  .lglobe-ic { width: 45%; height: 45%; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; opacity: .9; }
  .lspin { position: absolute; inset: 0; animation: lorbit 6s linear infinite; }
  .lplane { position: absolute; left: 50%; top: -0.75rem; transform: translateX(-50%); width: 2.75rem; height: 2.75rem; border-radius: 999px; background: var(--primary); color: var(--primary-foreground); display: grid; place-items: center; box-shadow: 0 8px 20px -6px color-mix(in oklab, var(--primary) 60%, transparent); }
  .lplane-ic { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transform: rotate(90deg); }

  @keyframes lorbit { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes lfloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

  .ltitle { margin-top: 2rem; font-family: var(--font-display); font-weight: 800; color: var(--navy); font-size: clamp(1.35rem, 4vw, 1.75rem); }
  .lstep { margin-top: .5rem; color: color-mix(in oklab, var(--navy) 65%, transparent); font-size: .95rem; min-height: 1.4rem; }
  .lpct { margin-top: .35rem; font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; color: var(--primary); }

  .ltip { margin-top: 1.75rem; background: var(--background); border: 1px solid var(--border); border-radius: 1rem; padding: 1rem 1.25rem; box-shadow: var(--shadow-soft); }
  .ltip-label { font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: var(--primary); font-weight: 700; }
  #iov-tip { margin-top: .4rem; min-height: 2.6rem; color: color-mix(in oklab, var(--navy) 80%, transparent); line-height: 1.5; transition: opacity .25s; }

  .lnot { font-size: 2.75rem; margin-bottom: .5rem; }
  .lbtn { display: inline-block; margin-top: 1.25rem; background: var(--primary); color: var(--primary-foreground); font-weight: 700; padding: .8rem 1.4rem; border-radius: 999px; box-shadow: var(--shadow-soft); }

  @media (prefers-reduced-motion: reduce) { .lspin, .lglobe { animation: none; } }
</style>
