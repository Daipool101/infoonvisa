---
const links = [
  { href: '/', label: 'Home' },
  { href: '/#popular', label: 'Countries' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
---

<header data-nav>
  <div class="wrap nav">
    <a href="/" class="logo" aria-label="InfoOnVisa home">
      <span class="dot" aria-hidden="true"><img src="/logo-icon.png" alt="" /></span>InfoOn<b>Visa</b>
    </a>
    <nav class="navlinks" id="nav-menu">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <button type="button" class="navtoggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>

<style>
  header {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 62px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    font-size: 19px;
    color: var(--brand);
  }
  .logo:hover { text-decoration: none; }
  .logo .dot {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: #fff;
    border: 1px solid var(--line);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .logo .dot img { width: 100%; height: 100%; object-fit: contain; }
  .logo b { color: var(--accent); font-weight: 700; }
  .navlinks { display: flex; gap: 26px; font-size: 15px; }
  .navlinks a { color: var(--brand); }

  /* Hamburger for phones — the link row used to spill off the screen. */
  .navtoggle { display: none; width: 44px; height: 44px; margin-right: -8px; flex: none; place-items: center; border: none; background: transparent; color: var(--brand); cursor: pointer; border-radius: 10px; }
  .bars { display: grid; gap: 5px; width: 20px; }
  .bars span { display: block; height: 2px; border-radius: 2px; background: currentColor; transition: transform .25s, opacity .2s; }

  @media (max-width: 720px) {
    .navtoggle { display: grid; }
    .navlinks {
      position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; gap: 0;
      padding: 4px 20px 12px;
      background: var(--surface); border-bottom: 1px solid var(--line);
      box-shadow: 0 18px 30px -20px rgba(0, 0, 0, .35);
      display: none;
    }
    header.open .navlinks { display: flex; }
    .navlinks a { padding: 15px 2px; font-size: 16px; border-bottom: 1px solid var(--line); }
    .navlinks a:last-child { border-bottom: none; }
    header.open .bars span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    header.open .bars span:nth-child(2) { opacity: 0; }
    header.open .bars span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }

  @media (prefers-reduced-motion: reduce) { .bars span { transition: none; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('header[data-nav]');
  const btn = bar?.querySelector<HTMLButtonElement>('.navtoggle');
  const menu = bar?.querySelector<HTMLElement>('.navlinks');
  if (bar && btn && menu) {
    const setOpen = (open: boolean) => {
      bar.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    btn.addEventListener('click', (e) => { e.stopPropagation(); setOpen(!bar.classList.contains('open')); });
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
    document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('header')) setOpen(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    window.matchMedia('(max-width: 720px)').addEventListener('change', (m) => { if (!m.matches) setOpen(false); });
  }
</script>
